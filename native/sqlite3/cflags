# How the sqlite3 amalgamation is compiled, one argument per line. These are
# also the flags `tuul bind sqlite3` preprocesses the header with, so the
# binding and the library can never disagree about what is in the API.
-DSQLITE_THREADSAFE=1
-DSQLITE_ENABLE_FTS5
-DSQLITE_ENABLE_RTREE
-DSQLITE_ENABLE_COLUMN_METADATA
-DSQLITE_ENABLE_NORMALIZE
-DSQLITE_ENABLE_PREUPDATE_HOOK
-DSQLITE_ENABLE_SNAPSHOT
-DSQLITE_ENABLE_UNLOCK_NOTIFY
-DSQLITE_DQS=0
